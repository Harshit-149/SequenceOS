NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://sequenceos:sequenceos@localhost:5432/sequenceos?schema=public
REDIS_URL=redis://localhost:6379
# Generate a unique 32+ byte secret, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_PROVIDER=console
DEFAULT_FROM_NAME=SequenceOS
DEFAULT_FROM_EMAIL=outreach@example.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
# Provider credentials belong in a secret manager in production. Do not commit real values.
INFRAOS_API_URL=
INFRAOS_API_KEY=
TRIAGEOS_WEBHOOK_SECRET=
